/*
Modern Popup Styles for ABA Application
Includes: Unified Validation Popup, Generated Task Popup, Detail Mode Notifications
*/

/* ===== UNIFIED VALIDATION POPUP STYLES ===== */

/* Main Container */
QFrame#mainContainer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(15, 20, 25, 0.98), stop:0.3 rgba(26, 31, 46, 0.95),
        stop:0.7 rgba(45, 55, 72, 0.92), stop:1 rgba(74, 85, 104, 0.90));
    border: 2px solid rgba(255, 255, 255, 0.08);
    border-radius: 15px;
    margin: 5px;
}

/* Header Title */
QLabel#popupTitle {
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:0.5 #f093fb, stop:1 #667eea);
    font-weight: bold;
    font-size: 18px;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 8px 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(102, 126, 234, 0.1), stop:1 rgba(240, 147, 251, 0.1));
    border-radius: 8px;
}

/* Window Control Buttons */
QPushButton#minimizeBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ffecd2, stop:1 #fcb69f);
    border: none;
    border-radius: 17px;
    color: #2d3748;
    font-weight: bold;
    font-size: 18px;
    box-shadow: 0px 4px 15px rgba(255, 183, 77, 0.4);
}

QPushButton#minimizeBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ff9a9e, stop:1 #fecfef);
    transform: scale(1.05);
}

QPushButton#minimizeBtn:pressed {
    transform: scale(0.95);
}

QPushButton#closeBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ff9a9e, stop:1 #fecfef);
    border: none;
    border-radius: 17px;
    color: #2d3748;
    font-weight: bold;
    font-size: 18px;
    box-shadow: 0px 4px 15px rgba(255, 154, 158, 0.4);
}

QPushButton#closeBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ff6b6b, stop:1 #ee5a52);
    color: white;
    transform: scale(1.05);
}

QPushButton#closeBtn:pressed {
    transform: scale(0.95);
}

/* Detail Mode Container */
QFrame#detailContainer {
    background-color: #18181b;
    border: 2px solid #404040;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(139, 92, 246, 0.1);
}

/* Detail Mode Header */
QLabel#detailHeader {
    font-size: 18px;
    font-weight: 700;
    color: #e4e4e4;
    padding: 12px 16px;
    background-color: #2a2a2a;
    border-radius: 10px;
    margin-bottom: 12px;
    border: 1px solid #404040;
}

/* Detail Mode Placeholder */
QLabel#detailPlaceholder {
    color: #e4e4e4;
    font-size: 28px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 100px;
    background-color: #1a1a1a;
    border-radius: 12px;
    border: 2px dashed rgba(255, 255, 255, 0.4);
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.3);
}

/* Form Section Labels */
QLabel#systemLabel, QLabel#userLabel {
    font-size: 16px;
    font-weight: 600;
    color: #e4e4e4;
    padding: 10px 14px;
    background-color: #2a2a2a;
    border-radius: 8px;
    margin: 8px 0;
    border: 1px solid #404040;
}

/* System Response Text Area */
QTextEdit#systemResponse {
    background-color: #2a2a2a;
    border: 2px solid #404040;
    border-radius: 10px;
    color: #f9fafb;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 13px;
    padding: 12px;
    selection-background-color: rgba(139, 92, 246, 0.3);
    line-height: 1.5;
}

QTextEdit#systemResponse:focus {
    border: 2px solid #0ea5e9;
    background-color: #2a2a2a;
    box-shadow: 0 0 20px rgba(14, 165, 233, 0.2);
}

/* User Response Text Area */
QTextEdit#userResponse {
    background-color: #2a2a2a;
    border: 2px solid #404040;
    border-radius: 10px;
    color: #f9fafb;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 13px;
    padding: 12px;
    selection-background-color: rgba(139, 92, 246, 0.3);
    line-height: 1.5;
}

QTextEdit#userResponse:focus {
    border: 2px solid #0ea5e9;
    background-color: #2a2a2a;
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.2);
}

/* Microphone Button */
QPushButton#micBtn {
    background-color: #404040;
    border: 1px solid #606060;
    border-radius: 22px;
    color: #ffffff;
    font-size: 18px;
    box-shadow: 0px 6px 20px rgba(102, 126, 234, 0.4);
}

QPushButton#micBtn:hover {
    background-color: #505050;
    border: 1px solid #0ea5e9;
    transform: scale(1.05);
    box-shadow: 0px 8px 25px rgba(168, 237, 234, 0.5);
}

QPushButton#micBtn:pressed {
    transform: scale(0.95);
    box-shadow: 0px 4px 15px rgba(102, 126, 234, 0.3);
}

/* Send Button */
QPushButton#sendBtn {
    background-color: #404040;
    border: 1px solid #606060;
    border-radius: 10px;
    color: white;
    font-weight: 600;
    font-size: 14px;
    padding: 12px 20px;
    min-width: 120px;
    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
}

QPushButton#sendBtn:hover {
    background-color: #505050;
    border: 1px solid #0ea5e9;
    box-shadow: 0 4px 20px rgba(14, 165, 233, 0.3);
    transform: translateY(-1px);
}

QPushButton#sendBtn:pressed {
    background-color: #3a3a3a;
    transform: translateY(0px);
    box-shadow: 0 2px 10px rgba(14, 165, 233, 0.2);
}

/* Validation Logs Container */
QFrame#logsContainer {
    background-color: #18181b;
    border: 2px solid #404040;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

/* Logs Header */
QLabel#logsHeader {
    font-size: 18px;
    font-weight: 700;
    color: #e4e4e4;
    padding: 12px 16px;
    background-color: #2a2a2a;
    border-radius: 10px;
    margin-bottom: 12px;
    border: 1px solid #404040;
}

/* Progress Label */
QLabel#progressLabel {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 8px 12px;
    background-color: #4169e1;
    border-radius: 6px;
    border: 1px solid #5a7fff;
}

/* Progress Bar */
QProgressBar#validationProgress {
    border: none;
    background-color: #2a2a2a;
    border-radius: 6px;
    text-align: center;
}

QProgressBar#validationProgress::chunk {
    background-color: #4169e1;
    border-radius: 6px;
    box-shadow: 0px 2px 8px rgba(65, 105, 225, 0.4);
}

/* Logs Display */
QTextEdit#logsDisplay {
    background-color: #2a2a2a;
    color: #ffffff;
    border: 2px solid #404040;
    border-radius: 10px;
    padding: 15px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 12px;
    selection-background-color: rgba(129, 199, 132, 0.3);
}

/* Custom Scrollbar for Logs */
QTextEdit#logsDisplay QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.1);
    width: 12px;
    border-radius: 6px;
}

QTextEdit#logsDisplay QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #81c784, stop:1 #aed581);
    border-radius: 6px;
    min-height: 20px;
}

QTextEdit#logsDisplay QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a5d6a7, stop:1 #c8e6c9);
}

/* ===== DETAIL MODE NOTIFICATION POPUPS ===== */

/* Detail Mode Started Notification */
QDialog#detailModeStarted {
    background-color: #18181b;
    border: 2px solid #404040;
    border-radius: 12px;
    box-shadow: 0px 10px 30px rgba(102, 126, 234, 0.4);
}

QLabel#detailStartedTitle {
    color: #ffffff;
    font-weight: bold;
    font-size: 18px;
    font-family: 'Segoe UI', Arial, sans-serif;
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.3);
}

QLabel#detailStartedMessage {
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Detail Mode Finished Notification */
QDialog#detailModeFinished {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #81c784, stop:0.5 #aed581, stop:1 #c8e6c9);
    border: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a5d6a7, stop:1 #dcedc8);
    border-radius: 12px;
    box-shadow: 0px 10px 30px rgba(129, 199, 132, 0.4);
}

QLabel#detailFinishedTitle {
    color: #2d3748;
    font-weight: bold;
    font-size: 18px;
    font-family: 'Segoe UI', Arial, sans-serif;
    text-shadow: 0px 1px 2px rgba(255, 255, 255, 0.3);
}

QLabel#detailFinishedMessage {
    color: rgba(45, 55, 72, 0.8);
    font-size: 14px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* ===== GENERATED TASKS POPUP STYLES ===== */

/* Generated Tasks Dialog */
QDialog#generatedTasksDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1a1d29, stop:0.3 #2d3748, stop:0.7 #4a5568, stop:1 #2d3748);
    border: 3px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:0.5 #764ba2, stop:1 #667eea);
    border-radius: 16px;
}

/* Task List Widget */
QListWidget#tasksList {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.08), stop:1 rgba(255, 255, 255, 0.04));
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 10px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    selection-background-color: rgba(102, 126, 234, 0.3);
}

QListWidget#tasksList::item {
    padding: 8px 12px;
    margin: 2px 0px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QListWidget#tasksList::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(102, 126, 234, 0.3), stop:1 rgba(118, 75, 162, 0.3));
    border: 1px solid rgba(102, 126, 234, 0.5);
}

QListWidget#tasksList::item:hover {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Task Action Buttons */
QPushButton#taskActionBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea, stop:1 #764ba2);
    border: none;
    border-radius: 8px;
    color: #ffffff;
    font-weight: bold;
    font-size: 12px;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 8px 16px;
    box-shadow: 0px 4px 12px rgba(102, 126, 234, 0.3);
}

QPushButton#taskActionBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #a8edea, stop:1 #fed6e3);
    transform: scale(1.02);
    box-shadow: 0px 6px 16px rgba(168, 237, 234, 0.4);
}

QPushButton#taskActionBtn:pressed {
    transform: scale(0.98);
    box-shadow: 0px 2px 8px rgba(102, 126, 234, 0.2);
}
